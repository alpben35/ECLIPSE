{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node build-apphosting.js",
    "start": "node dist/server.cjs",
    "deploy-rules": "npx firebase-tools deploy --only firestore:rules,storage",
    "deploy": "npm run build && npx firebase-tools deploy",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capgo/capacitor-purchases": "^6.0.0",
    "@google/genai": "^1.51.0",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "firebase": "^10.12.0",
    "firebase-admin": "^12.0.0",
    "firebase-tools": "^15.17.0",
    "lucide-react": "^0.378.0",
    "motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.0",
    "stripe": "^15.11.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.15.0",
    "typescript": "~5.8.2",
    "vite": "^5.4.15",
    "vite-plugin-pwa": "^0.20.5"
  },
  "devDependencies": {
  },
  "overrides": {
    "@capacitor/core": "$@capacitor/core",
    "@capacitor/android": "$@capacitor/android",
    "@capacitor/ios": "$@capacitor/ios",
    "@capacitor/cli": "$@capacitor/cli",
    "@capgo/capacitor-purchases": {
      "@capacitor/core": "$@capacitor/core"
    }
  },
  "resolutions": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  }
}
