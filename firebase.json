{
  "firestore": {
    "database": "ai-studio-2a66ed90-2fcf-4fc3-abef-a32720185065",
    "rules": "firestore.rules"
  },
  "storage": [
    {
      "bucket": "gen-lang-client-0438904042.firebasestorage.app",
      "rules": "storage.rules"
    }
  ],
  "functions": {
    "source": "backend/functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/eclipse-agent",
        "function": "eclipseAgent"
      },
      {
        "source": "/api/admin/agents",
        "function": "projectAgents"
      },
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(self), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://accounts.google.com https://checkout.stripe.com https://billing.stripe.com; upgrade-insecure-requests"
          }
        ]
      }
    ]
  }
}
