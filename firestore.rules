rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isPrimaryOwner() {
      return isAuthenticated() && 
             (request.auth.token.email == 'alp.ben@gmail.com' || request.auth.uid == 'GTk39aFMkFTSARasXr2F4XgdtMM2');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             (isPrimaryOwner() || 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'admin');
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
      
      match /scores/{scoreId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
      
      match /papers/{paperId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    match /friendships/{friendshipId} {
      allow read, write: if isAuthenticated();
    }

    match /friend_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bugs/{bugId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /ideas/{ideaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
      
      match /assignments/{assignmentId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    match /sent_emails/{emailId} {
      allow read, write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
