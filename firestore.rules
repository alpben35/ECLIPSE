rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // GLOBALS & HELPERS
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return request.auth.token.email_verified == true; }

    // Never derive privileges from a profile that the user can edit.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') == 'alp.ben@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function safeSelfProfile(data) {
      return data.get('uid', request.auth.uid) == request.auth.uid &&
        data.get('email', request.auth.token.get('email', '')) == request.auth.token.get('email', '') &&
        !(data.get('rank', 'Student') in ['Admin', 'Supreme Admin', 'Temporary Owner', 'Owner']) &&
        data.get('tier', 'free') == 'free' &&
        !data.keys().hasAny(['admin', 'isAdmin', 'banned', 'stripeCustomerId', 'subscriptionStatus']);
    }
    function safePublicProfile(data, userId) {
      return data.keys().hasOnly(['uid', 'username', 'displayName', 'displayName_lowercase', 'photoURL', 'level', 'rank', 'xp']) &&
        data.get('uid', userId) == userId &&
        !(data.get('rank', 'Student') in ['Admin', 'Supreme Admin', 'Temporary Owner', 'Owner']);
    }

    // ===============================================================
    // ENTITY VALIDATORS
    // ===============================================================

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'theme', 'xp', 'level', 'streak']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.theme in ['light', 'dark'] &&
             data.xp is number && data.level is number && data.streak is number;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['role', 'content', 'timestamp']) &&
             data.role in ['user', 'ai'] &&
             data.content is string && data.content.size() <= 50000 &&
             data.timestamp is timestamp;
    }

    function isValidTestScore(data) {
      return data.keys().hasAll(['uid', 'subject', 'percentage', 'date']) &&
             data.uid == request.auth.uid &&
             data.subject is string && data.subject.size() <= 100 &&
             data.percentage is number && data.percentage >= 0 && data.percentage <= 100 &&
             data.date is timestamp;
    }

    function isValidNotepad(data) {
      return data.keys().hasAll(['content', 'updatedAt']) &&
             data.content is string && data.content.size() <= 20000 &&
             data.updatedAt is string;
    }

    function isValidIdea(data) {
      return data.keys().hasAll(['uid', 'authorName', 'authorEmail', 'title', 'description', 'status', 'createdAt', 'currentReviewerRank']) &&
             data.uid == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 10000 &&
             data.status is string &&
             data.createdAt is string;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll(['from', 'to', 'status', 'timestamp']) &&
             data.keys().size() == 4 &&
             data.from == request.auth.uid &&
             data.to is string && data.to.size() <= 128 &&
             data.status == 'pending' &&
             data.timestamp is string && data.timestamp.size() <= 64;
    }

    function isValidFriendship(data) {
      return data.keys().hasAll(['users', 'timestamp']) &&
             data.keys().size() == 2 &&
             data.users is list &&
             data.users.size() == 2 &&
             data.users[0] is string && data.users[1] is string &&
             request.auth.uid in data.users &&
             data.timestamp is string && data.timestamp.size() <= 64;
    }

    function isValidGroupAssignment(data) {
      return data.keys().hasAll(['title', 'sharedBy', 'createdAt']) &&
             data.title is string && data.title.size() <= 2000 &&
             data.sharedBy == request.auth.uid &&
             data.createdAt is string &&
             (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 10000)) &&
             (!data.keys().hasAny(['dueDate']) || (data.dueDate is string && data.dueDate.size() <= 128)) &&
             (!data.keys().hasAny(['sharedByName']) || (data.sharedByName is string && data.sharedByName.size() <= 256));
    }

    // ===============================================================
    // RESOURCE MATCHES
    // ===============================================================

    // SYSTEM & CONFIG (ALLOW READ FOR ALL)
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{userId} { allow get: if isOwner(userId); allow list, write: if false; }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) && safeSelfProfile(incoming())) || isAdmin();
      allow update: if (isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'theme', 'xp', 'level', 'streak', 'lastActive', 'rank', 'createdAt', 'joinedAt',
          'promptsToday', 'lastPromptDate', 'imagesToday',
          'lastImageDate', 'consents', 'username', 'loginDays', 'photoURL', 'phone', 'updatedAt'
        ]) && (!incoming().diff(existing()).affectedKeys().hasAny(['rank']) || !(incoming().rank in ['Admin', 'Supreme Admin', 'Temporary Owner', 'Owner']))
      )) || isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidChatMessage(incoming());
        allow delete: if isOwner(userId) || isAdmin();
        allow update: if isAdmin();
      }

      match /scores/{scoreId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /papers/{paperId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /private/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if (isOwner(userId) && safePublicProfile(incoming(), userId)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /ideas/{ideaId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidIdea(incoming());
      allow update: if (isSignedIn() && (
        (isOwner(incoming().uid) && existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description'])) ||
        isAdmin()
      ));
      allow delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow get, list: if isAdmin() || (isSignedIn() && (existing().get('isPrivate', true) == false || request.auth.uid in existing().members));
      allow create: if isSignedIn() && incoming().createdBy == request.auth.uid &&
        incoming().members == [request.auth.uid] && incoming().isPrivate is bool &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 200;
      allow update: if isSignedIn() && (
        request.auth.uid == existing().createdBy ||
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['members']) &&
          request.auth.uid in existing().members &&
          !(request.auth.uid in incoming().members) &&
          existing().members.hasAll(incoming().members) &&
          incoming().members.size() == existing().members.size() - 1) ||
        (
          existing().get('isPrivate', false) == false &&
          incoming().diff(existing()).affectedKeys().hasOnly(['members']) &&
          incoming().members.hasAll(existing().members) &&
          incoming().members.size() == existing().members.size() + 1 &&
          request.auth.uid in incoming().members
        )
      );

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && (get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.uid]));
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid && (get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.uid]));
      }

      match /assignments/{assignmentId} {
        allow get, list: if isSignedIn() && (
          (exists(/databases/$(database)/documents/groups/$(groupId)) && (
            get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.uid]) ||
            get(/databases/$(database)/documents/groups/$(groupId)).data.get('isPrivate', false) == false
          )) ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          (exists(/databases/$(database)/documents/groups/$(groupId)) && (
            get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.uid])
          )) ||
          isAdmin()
        ) && isValidGroupAssignment(incoming());
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.sharedBy ||
          (exists(/databases/$(database)/documents/groups/$(groupId)) && request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy) ||
          isAdmin()
        );
      }
    }

    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
    }

    match /bugs/{bugId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    match /sent_emails/{emailId} {
      allow read, list: if isAdmin();
      allow create: if isSignedIn();
    }

    match /friend_requests/{requestId} {
      allow read, list: if isSignedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if isSignedIn() && isValidFriendRequest(incoming());
      allow delete: if isSignedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read, list: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create: if isSignedIn() && isValidFriendship(incoming());
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // ===============================================================
    // Admin agents never read student content. Runs are written by the server.
    match /agent_runs/{runId} { allow read: if isAdmin(); allow write: if false; }
    match /agent_messages/{messageId} { allow read: if isAdmin(); allow write: if false; }
    match /agent_tasks/{taskId} { allow read: if isAdmin(); allow write: if false; }
    match /agent_limits/{userId} { allow read, write: if false; }

    // DEFAULT DENY (LAST RESORT)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
